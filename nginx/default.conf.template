# nginx's entrypoint fills ${...} from environment variables when the container starts.
server {
  listen 80;
  root /usr/share/nginx/html;

  location / {
    try_files $uri /index.html;
  }

  # Browser calls /api/*  ->  gateway service (same-origin, so no CORS). Streaming needs buffering off.
  # A plain proxy_pass lets the container's own DNS lookup expand short names such as "trustrag-gateway"
  # (nginx's `resolver` directive ignores the search domains, which broke short names on Azure).
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;                            # trailing slash strips the /api prefix
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  location = /healthz {
    access_log off;
    return 200 "ok";
  }
}
